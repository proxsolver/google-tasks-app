# Google OAuth 2.0 설정
# 구글 클라우드 콘솔(https://console.cloud.google.com/)에서 발급받으세요
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth.js 설정
# 생성 방법: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL 데이터베이스 설정
# 로컬 개발용 PostgreSQL 사용 시 예시:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/google_tasks
DATABASE_URL=postgresql://user:password@localhost:5432/google_tasks

# 선택 사항: 배포 시 실제 URL로 변경
# NEXTAUTH_URL=https://your-domain.com
